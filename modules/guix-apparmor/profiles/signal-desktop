abi <abi/5.0>,

include <tunables/global>

@{signal}=/gnu/store/*-signal-desktop-*/lib/Signal

profile signal-desktop @{signal}/signal-desktop flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/audio>
  include <abstractions/dbus-session-strict>
  include <abstractions/dri-enumerate>
  include <abstractions/fonts>
  include <abstractions/mesa>
  include <abstractions/nameservice>
  include <abstractions/vulkan>
  include <abstractions/wayland>

  capability sys_admin,
  capability sys_chroot,
  capability sys_ptrace,
  userns,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  deny unix peer=(addr="@/tmp/.X11-unix/**"),
  deny /tmp/.X11-unix/** rw,

  signal (send, receive) peer=signal-desktop,
  ptrace (read, trace) peer=signal-desktop,
  deny ptrace (read) peer=unconfined,

  dbus send
       bus=session
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={RequestName,ReleaseName}
       peer=(name=org.freedesktop.DBus),
  dbus bind bus=session name=org.kde.StatusNotifierItem-*,
  dbus (send, receive)
       bus=session
       path={/StatusNotifierItem,/MenuBar,/StatusNotifierWatcher}
       peer=(label=unconfined),
  dbus (send, receive)
       bus=session
       path=/org/freedesktop/Notifications
       interface=org.freedesktop.Notifications
       peer=(label=unconfined),
  dbus (send, receive)
       bus=session
       path=/org/freedesktop/portal/{desktop,documents}{,/**}
       peer=(label=unconfined),
  dbus (send, receive)
       bus=session
       path=/org/freedesktop/secrets{,/**}
       peer=(label=unconfined),
  dbus send
       bus=session
       path=/org/freedesktop/ScreenSaver
       interface=org.freedesktop.ScreenSaver
       member={Inhibit,UnInhibit}
       peer=(label=unconfined),

  deny @{run}/dbus/system_bus_socket rw,

  /gnu/store/** mr,
  @{signal}/signal-desktop ix,
  @{signal}/chrome_crashpad_handler ix,

  /etc/ r,
  /etc/{os-release,mime.types,mailcap} r,
  /etc/ssl/** r,
  /etc/xdg/** r,

  @{PROC}/ r,
  owner @{PROC}/@{pid}/** r,
  owner @{PROC}/@{pid}/{uid_map,gid_map,setgroups,oom_score_adj,clear_refs} w,
  owner @{PROC}/@{pid}/task/@{tid}/comm w,
  @{PROC}/sys/** r,
  @{sys}/** r,

  /dev/dri/** rw,
  /dev/video* rw,
  /dev/shm/ r,
  owner /dev/shm/.org.chromium.Chromium.* rw,

  owner @{run}/user/@{uid}/ r,
  owner @{run}/user/@{uid}/pipewire-0 rw,
  owner @{run}/user/@{uid}/dconf/** rwk,
  owner @{run}/user/@{uid}/doc/** rw,

  owner /tmp/.org.chromium.Chromium.*/ rw,
  owner /tmp/.org.chromium.Chromium.*/** rw,
  owner /tmp/.org.chromium.Chromium.* rw,
  owner /tmp/scoped_dir*/ rw,
  owner /tmp/scoped_dir*/** rw,
  deny /{,var/}tmp/ r,

  owner @{HOME}/ r,
  owner @{HOME}/.config/Signal/ rw,
  owner @{HOME}/.config/Signal/** rwkl,
  owner @{HOME}/.config/{gtk-3.0,fontconfig,dconf}/** r,
  owner @{HOME}/.config/mimeapps.list r,
  owner @{HOME}/.local/share/{applications,mime,icons}/ r,
  owner @{HOME}/.local/share/{applications,mime,icons}/** r,
  deny owner @{HOME}/.local/share/pki/** rwk,
  owner @{HOME}/{@{XDG_DOWNLOAD_DIR},@{XDG_PICTURES_DIR},@{XDG_VIDEOS_DIR}}/ r,
  owner @{HOME}/{@{XDG_PICTURES_DIR},@{XDG_VIDEOS_DIR}}/** r,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/** rwk,
}
